{
  "name": "ucll-mobile-starter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "//": [
    "Held back from latest on purpose.",
    "Source of truth: expo@57.0.28 bundledNativeModules.json",
    "",
    "• expo/*, react, react-dom, react-native, @types/react",
    "    Follow the SDK 57 matrix.",
    "    Bump together, never individually.",
    "",
    "• react-native is 0.86.3",
    "    Not the newer 0.87.x / 0.88.x.",
    "",
    "• reanimated — required by expo-router",
    "• worklets — required by reanimated",
    "    Both pinned to the matrix.",
    "    Floating them pulls worklets 0.13.x,",
    "    breaking expo-modules-core's peer range.",
    "",
    "• @babel/* stays on v7",
    "    Until babel-preset-expo peers @babel/runtime v8.",
    "",
    "• typescript stays on 6.x",
    "    Until Expo supports TS 7."
  ],
  "//overrides": [
    "• decode-uri-component, uuid",
    "    Real vulnerability fixes.",
    "    Drop once the parent updates.",
    "",
    "• braces, node-forge — UNFIXABLE",
    "    Already newest version, still flagged.",
    "    GHSA-vfj7-8cjw-p6xm / GHSA-86w9-cpqp-85rv",
    "    Audit reports 18 highs, but only these 2 are real.",
    "    The other 16 just depend on them.",
    "    Build-time only, not in the app bundle.",
    "",
    "• The braces pin",
    "    Only stops npm resolving down to 2.x."
  ],
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "node scripts/cypress.js",
    "cypress:run": "node scripts/cypress.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "braces": "3.0.3",
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-flow": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@storybook/react": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "~19.2.18",
    "cypress": "^15.19.0",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
