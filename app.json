{
  "expo": {
    "name": "PinkyTime",
    "slug": "pinky-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pinky-time",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "icon": "./public/icons/icon-1024.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/ic_launcher_foreground.png",
        "monochromeImage": "./public/icons/ic_launcher_monochrome.png",
        "backgroundColor": "#2A1B3D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/favicon.ico"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
