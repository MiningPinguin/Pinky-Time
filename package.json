{
  "name": "pinky-time",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "//": [
    "Held back from latest on purpose.",
    "Source of truth: expo@57.0.28 bundledNativeModules.json",
    "",
    "• expo/*, react, react-dom, react-native, @types/react",
    "    Follow the SDK 57 matrix.",
    "    Bump together, never individually.",
    "",
    "• react-native is 0.86.3",
    "    Not the newer 0.87.x / 0.88.x.",
    "",
    "• reanimated — required by expo-router",
    "• worklets — required by reanimated",
    "    Both pinned to the matrix.",
    "    Floating them pulls worklets 0.13.x,",
    "    breaking expo-modules-core's peer range.",
    "",
    "• @babel/* stays on v7",
    "    Until babel-preset-expo peers @babel/runtime v8.",
    "",
    "• typescript stays on 6.x",
    "    Until Expo supports TS 7."
  ],
  "//overrides": [
    "• decode-uri-component, uuid",
    "    Real vulnerability fixes.",
    "    Drop once the parent updates.",
    "",
    "• braces, node-forge — UNFIXABLE",
    "    Already newest version, still flagged.",
    "    GHSA-vfj7-8cjw-p6xm / GHSA-86w9-cpqp-85rv",
    "    Audit reports 18 highs, but only these 2 are real.",
    "    The other 16 just depend on them.",
    "    Build-time only, not in the app bundle.",
    "",
    "• The braces pin",
    "    Only stops npm resolving down to 2.x."
  ],
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "tunnel": "expo start --tunnel",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "node scripts/cypress.js",
    "cypress:run": "node scripts/cypress.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "15.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "installed-apps": "file:./modules/installed-apps",
    "nativewind": "^4.2.7",
    "overlay": "file:./modules/overlay",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "braces": "3.0.3",
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/react": "~19.3.0",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "postcss": "^8.5.32",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "cypress@16.2.1": true
  }
}
